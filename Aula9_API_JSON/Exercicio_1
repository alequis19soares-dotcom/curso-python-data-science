import requests
import pandas as pd
import matplotlib.pyplot as plt


print("Passo 1: A chamar a API 'JSONPlaceholder'...")


url_da_api = "https://jsonplaceholder.typicode.com/todos"

try:
  
    resposta = requests.get(url_da_api)
 
    resposta.raise_for_status() 
    
    print("Sucesso! A API respondeu com o código 200 (OK).")

except requests.exceptions.RequestException as e:
    print(f"Erro ao chamar a API: {e}")
    exit()


print("\nA processar a resposta JSON...")
dados_em_lista = resposta.json()
print("\nTransformar a Lista em DataFrame...")

df_tarefas = pd.DataFrame(dados_em_lista)

print("Dados carregados e transformados em DataFrame:")
print(df_tarefas.head()) 
print("\n" + "="*40 + "\n")
id_de_interesse = ['1', '15', '57', '101', '150']
df_filtrado = df_tarefas[ df_tarefas['id'].isin(id_de_interesse)]
print(df_filtrado)
plt.figure(figsize=(10, 6))
df_grafico = df_filtrado.set_index('id')
df_grafico['title'].plot(
kind='bar', 
rot=0
)
title='Tarefas Selecionadas por ID',
plt.ylabel=('ID do Usuário'),
plt.xlabel=('ID da Tarefa'),
plt.tight_layout()
plt.show()
print("\nProjeto de API concluído!")